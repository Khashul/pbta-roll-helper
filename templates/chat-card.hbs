<div class="pbta-roll-card pbta-result-{{result}} {{themeClass}}" data-pbta-theme="{{themeKey}}" data-pbta-current-result="{{result}}" style="--pbta-result-bg: {{resultData.background}}; --pbta-result-outline: {{resultData.outline}};">
  <header class="pbta-card-header">
    <div class="pbta-card-header-main">
      <h2 class="pbta-card-title">{{{moveTitle}}}</h2>
      <div class="pbta-card-total" data-pbta-total-line>{{outcomeIcon}} {{total}}</div>
    </div>
    <div class="pbta-card-result-label" data-pbta-result-label>{{resultLabel}}</div>
  </header>

  <section class="pbta-card-body">
    <p class="pbta-card-meta">
      <strong>{{{actorName}}}</strong> - {{{statLabel}}} {{statModifier}}
      {{#if hasSituationalModifier}}
        <span class="pbta-card-modifier-note">{{#if modifierReason}}{{modifierReason}}{{/if}} {{situationalModifierText}}</span>
      {{/if}}
    </p>

    {{#if hasSpendableResource}}
      <div class="pbta-resource-control" data-pbta-resource hidden>
        <div class="pbta-resource-form" data-pbta-resource-form>
          <label>Spend <span data-pbta-resource-label>Resource</span> <span class="pbta-resource-available">(<span data-pbta-resource-available>0</span> available)</span></label>
          <div class="pbta-resource-row">
            <input type="number" min="1" step="1" value="1" data-pbta-resource-input>
            <button type="button" data-pbta-resource-spend>Add Successes</button>
          </div>
        </div>
        <div class="pbta-resource-spent" data-pbta-resource-spent hidden></div>
        <div class="pbta-resource-locked" data-pbta-resource-locked hidden></div>
      </div>
    {{/if}}

    {{#if showFullMove}}
      <details class="pbta-full-move {{animatedDetailsClass}}" {{fullMoveOpenAttribute}}>
        <summary><strong>Full Move</strong></summary>
        <div class="pbta-full-move-body">{{{fullDescription}}}</div>
      </details>
    {{/if}}

    {{#if showOutcomeSection}}
      <details class="pbta-result-text {{animatedDetailsClass}}" {{resultTextOpenAttribute}} data-pbta-outcome-section {{#unless showOutcomeText}}hidden{{/unless}}>
        <summary><strong><span data-pbta-outcome-heading-line>{{outcomeIcon}} {{outcomeHeading}}</span></strong></summary>
        <div class="pbta-result-text-body">{{{outcomeHtml}}}</div>
      </details>
    {{/if}}

    {{#if diceBreakdown}}
      <details class="pbta-dice-breakdown {{animatedDetailsClass}}">
        <summary class="pbta-dice-header">
          <strong>🎲 Dice Details</strong>
          <span class="pbta-dice-total">{{diceBreakdown.modeLabel}} · {{diceBreakdown.total}}</span>
        </summary>

        <div class="pbta-dice-body">
          <div class="pbta-dice-grid">
            <strong>Rolled</strong>
            <div>{{{diceBreakdown.rolledHtml}}}</div>

            <strong>Kept</strong>
            <div>{{{diceBreakdown.keptHtml}}}</div>

            {{#if diceBreakdown.hasDropped}}
              <strong>Dropped</strong>
              <div>{{{diceBreakdown.droppedHtml}}}</div>
            {{/if}}

            <strong>Stat</strong>
            <div>{{diceBreakdown.statModifierText}}</div>

            {{#if diceBreakdown.hasSituationalModifier}}
              <strong>Situation</strong>
              <div>{{#if diceBreakdown.modifierReason}}{{diceBreakdown.modifierReason}}{{/if}} {{diceBreakdown.situationalModifierText}}</div>
            {{/if}}

            <strong>Total Mod</strong>
            <div>{{diceBreakdown.modifierText}}</div>
          </div>

          <div class="pbta-dice-equation">{{diceBreakdown.equation}}</div>
        </div>
      </details>
    {{/if}}

    {{#if showRollHtml}}
      {{{rollHtml}}}
    {{/if}}

    {{#if showDebugInfo}}
      <div class="pbta-debug-info">
        <strong>GM Debug</strong> — Adapter: {{debugInfo.adapter}} · Group: {{debugInfo.moveGroup}} · Stat: {{{debugInfo.detectedStat}}} · Cache: {{#if debugInfo.cacheHit}}hit{{else}}miss{{/if}}
      </div>
    {{/if}}
  </section>
</div>
